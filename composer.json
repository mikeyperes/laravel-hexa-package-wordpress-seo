{
  "name": "hexawebsystems/laravel-hexa-package-wordpress-seo",
  "description": "Live SEO view of one WordPress site for HWS skills: Rank Math page fields, indexability, internal links and image fields.",
  "type": "library",
  "license": "MIT",
  "version": "0.4.1",
  "require": {
    "php": "^8.2",
    "hexawebsystems/laravel-hexa-package-whm": "*",
    "hexawebsystems/laravel-hexa-package-wordpress": "*",
    "hexawebsystems/laravel-hexa-package-wptoolkit": "*"
  },
  "autoload": {
    "psr-4": {
      "hexa_package_wordpress_seo\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "hexa_package_wordpress_seo\\Providers\\WordPressSeoServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
